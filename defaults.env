# NoneBot reads a setting that no config model declares, such as an adapter's
# bot list, from the environment only when a dotenv file names it. These are
# the defaults; set the real values in the environment. A platform is enabled
# by giving it a connection.
ONEBOT_V11_WS_URLS=[]
DISCORD_BOTS=[]
TELEGRAM_BOTS=[]
TELEGRAM_PROXY=null
